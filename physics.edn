;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": for freight forwarding and customs brokerage
;; (ISIC 5229) robots do customs-document scanning and verification and
;; cross-dock staging and consolidation, gated by the Freight Forwarding
;; Governor. Physical work modelled here: an autonomous pallet mover taking
;; a consolidated pallet from the inbound door to the outbound staging lane,
;; and an arm lifting a parcel onto the inspection scanner's conveyor.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-5229"
 :cases
 [{:id :crossdock-pallet-move
   :kind :transport
   :procedure "autonomous pallet mover carries a consolidated pallet 80 m from the inbound dock door to the outbound staging lane"
   :params {:mass-kg 350.0 :distance-m 80.0 :v-max-mps 1.8 :a-max-mps2 0.5
            :brake-decel-mps2 1.2 :drive-force-n 900.0 :crr 0.012
            :cog-height-m 0.3 :support-half-length-m 0.45 :payload-cog-height-m 1.0
            :max-time-s 1200.0}
   :sweep {:param :payload-kg :values [200.0 500.0 800.0 1200.0 1600.0]}
   :quantity :min-tipover-margin
   :limit {:min 0.5 :basis "estimate: keep half the static longitudinal margin for a 1.6 m-high stacked pallet whose load may shift"}}
  {:id :parcel-to-xray-conveyor
   :kind :manipulator
   :procedure "arm lifts a parcel from the consolidation cage onto the in-feed conveyor of the customs X-ray scanner"
   :params {:l1-m 0.70 :l2-m 0.60 :m1-kg 10.0 :m2-kg 7.0
            :from [0.80 -0.10] :to [0.40 0.75] :duration-s 2.0 :steps 500}
   :sweep {:param :payload-kg :values [2.0 8.0 15.0 25.0 35.0]}
   :quantity :peak-tau1-nm
   :limit {:max 300.0 :basis "estimate: continuous shoulder torque of a ~20 kg-payload collaborative arm class"}
   :boundary {:lo 0.5 :hi 80.0}}]}
