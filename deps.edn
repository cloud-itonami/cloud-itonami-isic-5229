{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; This freight-forwarding/customs-brokerage vertical is an OPERATIONS
 ;; COORDINATION actor (freight-forwarding/customs-documentation data
 ;; logging, routing/consolidation scheduling proposals, customs-
 ;; documentation/regulatory-compliance-concern flagging,
 ;; carrier-booking coordination) -- it never itself holds
 ;; customs-clearance or shipment-release authority (see
 ;; `freightforwarding.governor`'s `finalize-clearance-violations`: any
 ;; proposal to directly finalize a customs-clearance or shipment-
 ;; release decision is a hard, permanent block, and the closed
 ;; op-allowlist contains no such op in the first place). This repo is
 ;; standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates.
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.robotics"}

        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + field-spec entity helpers) -- this store is an
        ;; entity-store adopter (ADR-2607141600), NOT a hand-rolled
        ;; enc/dec* copy.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langchainStore"}
        ;; デジタル庁デザインシステム (DADS) -- the workspace-wide base
        ;; design system (superproject AGENTS.md, 2026-08-05). Consumed as
        ;; a git dep (never :local/root -- that breaks for a standalone
        ;; fork resolving out of the git cache). Used ONLY by
        ;; `freightforwarding.render-html`, the build-time generator for
        ;; docs/samples/operator-console.html.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  :physai-test {:extra-paths ["test" "test-physai"] :main-opts ["-m" "cognitect.test-runner"]}
;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "freightforwarding.sim"]}
  ;; kbb -M:dev:render-html -> regenerate docs/samples/operator-console.html
  ;; by actually running the actor stack (never hand-written HTML).
  :render-html {:main-opts ["-m" "freightforwarding.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
